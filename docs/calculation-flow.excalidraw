    {
      "type": "text",
      "id": "evidence_metrics_text",
      "x": 100,
      "y": 335,
      "width": 540,
      "height": 170,
      "text": "compute_kpi() evidence:\ndt_hours = Timestamp.diff()/3600\ntotal_kwh = Σ(total_kw_i * dt_i)\navg_kw = total_kwh / Σ(dt_i)\nload_factor = avg_kw / peak_kw * 100\ntotal_cost = total_kwh * price_per_kwh\ntotal_carbon_kg = total_kwh * carbon_kg_per_kwh",
      "originalText": "compute_kpi() evidence:\ndt_hours = Timestamp.diff()/3600\ntotal_kwh = Σ(total_kw_i * dt_i)\navg_kw = total_kwh / Σ(dt_i)\nload_factor = avg_kw / peak_kw * 100\ntotal_cost = total_kwh * price_per_kwh\ntotal_carbon_kg = total_kwh * carbon_kg_per_kwh",
