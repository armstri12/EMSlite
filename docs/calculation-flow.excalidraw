    {
      "type": "text",
      "id": "evidence_behavior_text",
      "x": 724,
      "y": 605,
      "width": 600,
      "height": 145,
      "text": "Behavior + trending evidence:\nshift_kwh = Σ(kW_i * dt_i where 6:00-14:30 weekday ET)\nphantom_kw = percentile_25(kW during 23:00-04:00 ET)\npct_change = (recent_kwh - prior_kwh) / prior_kwh * 100\ndirection = rising/falling/stable with ±5% threshold",
      "originalText": "Behavior + trending evidence:\nshift_kwh = Σ(kW_i * dt_i where 6:00-14:30 weekday ET)\nphantom_kw = percentile_25(kW during 23:00-04:00 ET)\npct_change = (recent_kwh - prior_kwh) / prior_kwh * 100\ndirection = rising/falling/stable with ±5% threshold",
